{
  "name": "@amirabaris/webhook-kit",
  "version": "0.1.2",
  "description": "Zero-dependency, edge-compatible webhook signature verification toolkit using Web Cryptography API",
  "keywords": [
    "webhook",
    "webhooks",
    "signature",
    "verification",
    "hmac",
    "crypto",
    "crypto-subtle",
    "edge",
    "cloudflare-workers",
    "nextjs",
    "hono",
    "fastify"
  ],
  "homepage": "https://github.com/AmirAbaris/webhook-kit#readme",
  "bugs": {
    "url": "https://github.com/AmirAbaris/webhook-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmirAbaris/webhook-kit.git"
  },
  "license": "MIT",
  "author": "Amir Abaris",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "webhook-kit": "./bin/webhook-kit.mjs"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "docs/agent-rules.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsd --files 'tests-d/**/*.test-d.ts'",
    "test:smoke": "node ./tests/package-smoke.mjs",
    "lint": "oxlint . && eslint . && prettier --check . && tsc -p tsconfig.lint.json --noEmit",
    "format": "eslint --fix . && prettier --write .",
    "prepare": "lefthook install",
    "prepack": "node -e \"import('node:fs').then(fs => { if (!fs.existsSync('dist/index.mjs')) import('node:child_process').then(cp => cp.execSync('pnpm build', { stdio: 'inherit' })) })\""
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "lefthook": "^2.2.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsd": "^0.33.0",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unrun": "^0.3.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "publishConfig": {
    "access": "public"
  }
}
