{
  "name": "webhook-kit",
  "version": "0.1.0",
  "description": "Zero-dependency, edge-compatible webhook signature verification toolkit using Web Cryptography API",
  "keywords": [
    "webhook",
    "webhooks",
    "signature",
    "verification",
    "hmac",
    "crypto",
    "crypto-subtle",
    "edge",
    "cloudflare-workers",
    "nextjs",
    "hono",
    "fastify"
  ],
  "homepage": "https://github.com/AmirAbaris/webhook-kit#readme",
  "bugs": {
    "url": "https://github.com/AmirAbaris/webhook-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmirAbaris/webhook-kit.git"
  },
  "license": "MIT",
  "author": "Amir Abaris",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "prepack": "pnpm build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "publishConfig": {
    "access": "public"
  }
}
