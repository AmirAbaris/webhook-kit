{
  "name": "webhook-kit-docs",
  "version": "0.0.1",
  "description": "Documentation site for webhook-kit (Next.js + shadcn)",
  "homepage": "https://webhook-kit.vercel.app",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --workspace-root run build && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "pnpm --workspace-root run build && tsc --noEmit",
    "shadcn:add": "pnpm dlx shadcn@latest add"
  },
  "dependencies": {
    "@amirabaris/webhook-kit": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
